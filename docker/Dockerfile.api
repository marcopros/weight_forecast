FROM python:3.11-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and configs
COPY src/ src/
COPY configs/ configs/

# Copy model and reference data (fallback if no volume mount)
COPY data/processed/lgbm_quantile_tau0.2.joblib data/processed/
COPY data/processed/master_for_modeling.csv data/processed/
COPY data/processed/predictions_2025.csv data/processed/
COPY data/processed/error_analysis.json data/processed/

# Copy metrics.json (root-level)
COPY metrics.json .

# Copy extended data for material features
COPY data/extended/ data/extended/

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
